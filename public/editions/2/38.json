ransform=\"matrix(10.5,0,0,-10.5,200.1065,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,208.90552,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_50\" transform=\"matrix(10.5,0,0,-10.5,211.6355,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,219.93051,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_12_3101\" transform=\"matrix(10.5,0,0,-10.5,222.66053,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,231.45954,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_47\" transform=\"matrix(10.5,0,0,-10.5,234.18952,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,239.96454,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_12_3101\" transform=\"matrix(10.5,0,0,-10.5,242.69455,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,251.49353,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_44\" transform=\"matrix(10.5,0,0,-10.5,254.22357,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,258.10856,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_12_3101\" transform=\"matrix(10.5,0,0,-10.5,260.83857,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_3\" transform=\"matrix(10.5,0,0,-10.5,269.63758,25.861573)\" fill=\"#173d65\"/>\n<use xlink:href=\"#font_11_39\" transform=\"matrix(10.5,0,0,-10.5,272.36756,25.861573)\" fill=\"#173d65\"/>\n</g>\n</svg>\n","S → O → L → I → D"],["heading","Java example"],["code","interface Payment { void pay(); }"],["code","class Card implements Payment { public void pay() {} }"],["code","class Checkout {"],["code","  private final Payment payment;"],["code","  Checkout(Payment payment) { this.payment = payment; }"],["code","  void run() { payment.pay(); }"],["code","}"],["heading","Five principles, one by one"],["text","SRP: One reason to change. Separate billing from emailing."],["text","OCP: Open for extension, closed for modification. Add a new Payment implementation."],["text","LSP: Subtypes must honor the base contract. A replacement must not break callers."],["text","ISP: Prefer focused interfaces. Do not force a printer-only device to implement scan()."],["text","DIP: High-level and low-level code depend on abstractions. Checkout depends on Payment."],["text","Interview question: What are the five SOLID principles?"],["text","Answer: Single Responsibility, Open/Closed, Liskov Substitution, Interface Segregation and"],["text","Dependency Inversion."],["text","Remember: S → O → L → I → D"]]