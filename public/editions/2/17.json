[["text","SECTION 02 / COMPLETE INTERVIEW EDITION"],["heading","Object-Oriented Programming\nAdditional 30 lessons"],["text","Original lessons 1–15 are preserved in the first 16 pages of the combined PDF. This supplement"],["text","expands them with topics 16–45. These are independent Java examples; statements marked"],["text","Inside main belong in a main method."],["sinhala","","මුල් lessons 15 Jවෙනස් කර නැහැ. අමතර concepts 30 Jමහි Sinhala + English explanations,",457],["sinhala","","examples සහ interview answers සමඟ ඇතුළත් කර ඇත.",292],["heading","Additional topics"],["text","16. Getters and Setters"],["text","31. Immutable Classes"],["text","17. Object State, Behavior and Identity"],["text","32. Diamond Problem"],["text","18. final Keyword"],["text","33. Multiple Interfaces"],["text","19. Constructor Chaining"],["text","34. Abstract Class vs Concrete Class"],["text","20. Early Binding vs Late Binding"],["text","35. Composition over Inheritance"],["text","21. Dynamic Method Dispatch"],["text","36. SOLID Principles"],["text","22. Upcasting vs Downcasting"],["text","37. DRY, KISS and YAGNI"],["text","23. instanceof Operator"],["text","38. Object-Oriented Design (OOD)"],["text","24. Object Class"],["text","39. UML Class Diagrams"],["text","25. equals() vs =="],["text","40. Design Patterns"],["text","26. equals() and hashCode()"],["text","41. Inversion of Control (IoC)"],["text","27. toString() Method"],["text","42. Nested and Inner Classes"],["text","28. Method Hiding"],["text","43. Anonymous Classes"],["text","29. Object Lifecycle"],["text","44. Functional Interfaces"],["text","30. Shallow Copy vs Deep Copy"],["text","45. Generics"],["text","Study method: Read the definition, explain the diagram, type the code yourself, then answer"],["text","the interview question without looking."]]