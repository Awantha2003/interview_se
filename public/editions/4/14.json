ll=\"#18283a\"/>\n<use xlink:href=\"#font_9_614\" transform=\"matrix(10.5,0,0,-10.5,262.72084,21.536225)\" fill=\"#18283a\"/>\n<use xlink:href=\"#font_9_604\" transform=\"matrix(10.5,0,0,-10.5,268.72685,21.536225)\" fill=\"#18283a\"/>\n</g>\n</svg>\n","fib(0)=0, fib(1)=1 → fib(2)=1 → fib(3)=2 → fib(4)=3"],["heading","JAVA EXAMPLE"],["code","static long fib(int n){\n    if(n<0)throw new IllegalArgumentException();\n    long a=0,b=1;\n    for(int i=0;i<n;i++){long t=a+b;a=b;b=t;}\n    return a;\n}"],["heading","OUTPUT AND ANALYSIS"],["text","fib(6)=8. O(n) time and O(1) auxiliary space; use small n to avoid overflow."],["heading","INTERVIEW QUESTION"],["heading","Why is DP faster than naive recursive Fibonacci?"],["text","It avoids repeatedly solving the same subproblems."],["heading","PRACTICE YOURSELF"],["text","Find fib(7)."]]