[["heading","LESSON 05 / 27 · ORIGINAL"],["heading","Bubble, selection and insertion sort"],["heading","SIMPLE ENGLISH"],["text","Bubble sort swaps adjacent inversions; selection sort selects a minimum; insertion sort\ninserts into a sorted prefix."],["sinhala","","සිංහJලෙන් පැහැදිලි කිරීම",132],["sinhala","","Bubble sort එක අසල්වුසි values compare කර swap කරනවා. Selection sort එක ඉතිරි JකාටJස් minimum එක Jතෙතෝරනවා. Insertion sort එක sorted Jකාටසට value එක නිවුරදි තෙුනට දොනවා.",463],["heading","REAL-WORLD EXAMPLE"],["text","Sorting marks in ascending order."],["heading","STEP-BY-STEP VISUAL TRACE"],["diagram","<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" version=\"1.1\" width=\"483.02836\" height=\"35.532838\" viewBox=\"0 0 483.02836 35.532838\">\n<defs>\n<clipPath id=\"clip_1\">\n<path transform=\"matrix(1,0,0,-1,-56.12362,553.77969)\" d=\"M56.12362 518.2468H539.152V553.77969H56.12362Z\" clip-rule=\"evenodd\"/>\n</clipPath>\n<clipPath id=\"clip_2\">\n<path transform=\"matrix(.75,0,0,.75,-56.12362,-288.1101)\" d=\"M83.59055 385.34675H710.1102C714.2677 385.34675 717.6693 388.74833 717.6693 392.9058V422.76487C717.6693 426.92234 714.2677 430.3239 710.1102 430.3239H83.59055C79.43307 430.3239 76.031497 426.92234 76.031497 422.76487V392.9058C76.031497 388.74833 79.43307 385.34675 83.59055 385.34675\"/>\n</clipPath>\n<clipPath id=\"clip_3\">\n<path transform=\"matrix(.75,0,0,.75,-56.12362,-288.1101)\" d=\"M76.031497 385.34675H717.6693V430.3239H76.031497Z\"/>\n</clipPath>\n<clipPath id=\"clip_4\">\n<path transform=\"matrix(.75,0,0,.75,-56.12362,-288.1101)\" d=\"M76.031497 464.94627H717.6693V628.02346H76.031497Z\"/>\n</clipPath>\n<clipPath id=\"clip_5\">\n<path transform=\"matrix(.75,0,0,.75,-56.12362,-288.1101)\" d=\"M76.031497 464.94627H717.6693V628.02346H76.031497Z\"/>\n</clipPath>\n<clipPath id=\"clip_6\">\n<path transform=\"matrix(.75,0,0,.75,-56.12362,-288.1101)\" d=\"M76.031497 628.02346V464.94627H79.031497V628.02346\" clip-r