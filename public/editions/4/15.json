id subsets(int[] a,int i,java.util.List<Integer> cur){\n    if(i==a.length){System.out.println(cur);return;}\n    subsets(a,i+1,cur);\n    cur.add(a[i]);\n    subsets(a,i+1,cur);\n    cur.remove(cur.size()-1);\n}"],["heading","OUTPUT AND ANALYSIS"],["text","For [1,2]: [], [2], [1], [1,2]. 2^n subsets; printing takes O(n·2^n) total."],["heading","INTERVIEW QUESTION"],["heading","What is pruning?"],["text","Stopping a branch once it cannot lead to a valid solution."],["heading","PRACTICE YOURSELF"],["text","How many subsets of 3 distinct items?"]]