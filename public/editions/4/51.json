.57099917 .5389862 .48199464H.6819916Z\"/>\n</defs>\n<g clip-path=\"url(#clip_1)\">\n<path transform=\"matrix(1,0,0,-1,-77.1,662.9)\" stroke-width=\"1.4\" stroke-linecap=\"butt\" stroke-miterlimit=\"10\" stroke-linejoin=\"miter\" fill=\"none\" stroke=\"#087e83\" d=\"M123 640H274\"/>\n<path transform=\"matrix(1,0,0,-1,-77.1,662.9)\" d=\"M274 640 266.7964 643.4797V636.5203Z\" fill=\"#087e83\" fill-rule=\"evenodd\"/>\n<path transform=\"matrix(1,0,0,-1,-77.1,662.9)\" stroke-width=\"1.4\" stroke-linecap=\"butt\" stroke-miterlimit=\"10\" stroke-linejoin=\"miter\" fill=\"none\" stroke=\"#087e83\" d=\"M320 640H472\"/>\n<path transform=\"matrix(1,0,0,-1,-77.1,662.9)\" d=\"M472 640 464.7964 643.4797V636.5203Z\" fill=\"#087e83\" fill-rule=\"evenodd\"/>\n<use xlink:href=\"#font_2_34\" transform=\"matrix(12,0,0,-12,18.568,26.900025)\" fill=\"#23384a\"/>\n<use xlink:href=\"#font_2_35\" transform=\"matrix(12,0,0,-12,215.568,26.900025)\" fill=\"#23384a\"/>\n<use xlink:href=\"#font_2_36\" transform=\"matrix(12,0,0,-12,413.568,26.900025)\" fill=\"#23384a\"/>\n</g>\n</svg>\n","A B C"],["heading","HOW TO READ THE DIAGRAM"],["text","1. A has indegree zero, so add A to the queue first."],["text","2. Remove A and reduce B indegree to zero; process B next."],["text","3. Removing B allows C. The result A, B, C respects all prerequisites."],["heading","INTERVIEW MEMORY TIP"],["text","A topological ordering exists only for a directed acyclic graph (DAG)."]]