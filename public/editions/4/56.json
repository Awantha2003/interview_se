9994 .61099246 .32099916 .61099246 .35299684 .57699587 .35299684 .5179901 .35299684 .44599916 .31199647 .41099549 .22898865 .41099549H.21699524V.31698609Z\"/>\n</defs>\n<g clip-path=\"url(#clip_1)\">\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" stroke-width=\"1.4\" stroke-linecap=\"butt\" stroke-miterlimit=\"10\" stroke-linejoin=\"miter\" fill=\"none\" stroke=\"#087e83\" d=\"M118 650H277\"/>\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" d=\"M277 650 269.7964 653.4797V646.5203Z\" fill=\"#087e83\" fill-rule=\"evenodd\"/>\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" stroke-width=\"1.4\" stroke-linecap=\"butt\" stroke-miterlimit=\"10\" stroke-linejoin=\"miter\" fill=\"none\" stroke=\"#087e83\" d=\"M319.6255 638.0066 460.3745 551.9934\"/>\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" d=\"M460.3745 551.9934 456.0423 558.7188 452.4133 552.7805Z\" fill=\"#087e83\" fill-rule=\"evenodd\"/>\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" stroke-width=\"1.4\" stroke-linecap=\"butt\" stroke-miterlimit=\"10\" stroke-linejoin=\"miter\" fill=\"none\" stroke=\"#087e83\" d=\"M460.3745 551.9934 319.6255 638.0066\"/>\n<path transform=\"matrix(1,0,0,-1,-72.1,672.9)\" d=\"M319.6255 638.0066 323.9577 631.2812 327.5867 637.2195Z\" fill=\"#087e83\" fill-rule=\"evenodd\"/>\n<use xlink:href=\"#font_2_18\" transform=\"matrix(12,0,0,-12,19.564003,26.900025)\" fill=\"#23384a\"/>\n<use xlink:href=\"#font_2_19\" transform=\"matrix(12,0,0,-12,224.564,26.900025)\" fill=\"#23384a\"/>\n<use xlink:href=\"#font_2_20\" transform=\"matrix(12,0,0,-12,404.564,136.90003)\" fill=\"#23384a\"/>\n</g>\n</svg>\n","1 2 · 3"],["heading","HOW TO READ THE DIAGRAM"],["text","1. Slow pointer moves one step; fast pointer moves two steps."],["text","2. Starting at node 1: after step 1 slow=2, fast=3; after step 2 slow=3, fast=3."],["text","3. Their meeting proves a cycle. In an acyclic list, fast eventually reaches null."],["heading","INTERVIEW MEMORY TIP"],["text","Floyd cycle detection uses O(n) time and O(1) extra space."]]