[["heading","SECTION 33 / INTERVIEW PREPARATION"],["heading","Mock technical interview & demo"],["text","Use a fictional dataset in demos and do not expose employer secrets. Record your own answers, then"],["text","review whether they are supported."],["heading","Time\nPractice task"],["text","0–2 min\nIntroduce yourself and confirm availability."],["text","2–5 min\nExplain your strongest project and draw the actual architecture."],["text","5–9 min\nTrace one API call, including validation, auth, database access, and a failure."],["text","9–12 min\nDiscuss LGPS verification or an actual deployment, with technical boundaries."],["text","12–15 min\nExplain a real bug, test evidence, tradeoffs and improvement."],["heading","Demo checklist"],["text","□ README and run instructions   □ safe sample data"],["text","□ key feature   □ error path   □ fallback screenshots"],["text","□ personal contribution evidence   □ no secrets"],["heading","Self-review"],["text","□ Did I distinguish team and individual work?"],["text","□ Did I explain why, not just what technology?"],["text","□ Did I use actual details or label proposals?"],["text","□ Can I trace a real request and describe a real test?"],["heading","Final reminder"],["sinhala","","Interview එJකේදී technical answer එක තමන්Jගේ real experience එකට සමේබන්ධ කරන්න. CV එJකේ",481],["sinhala","","නුති details verify කරලා පමණකේ කියන්න.",213]]